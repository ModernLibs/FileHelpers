root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# ──────────────────────────────────────────────────────────────────────────────
# Sealed classes
# ──────────────────────────────────────────────────────────────────────────────
# Roslynator: make class sealed
dotnet_diagnostic.RCS1225.severity = error
# NetAnalyzers: seal internal types (CA1852)
# CA1852 fires for internal unsealed concrete types. It does NOT fire for public types —
# this is by design (public types may be intentionally inheritable by external assemblies).
# No standard Roslyn analyzer unconditionally enforces sealing for public types.
# Project convention (enforced in code review): public classes are sealed, abstract or static unless
# they are designed for inheritance.
# RCS1225 covers public classes only when all constructors are private (automatic case only).
dotnet_diagnostic.CA1852.severity = error

# ──────────────────────────────────────────────────────────────────────────────
# Nullable strictness
# <Nullable>enable</Nullable> in Directory.Build.props reports these as warnings; setting them to
# error here makes them build errors in every project, including the generator, which is excluded
# from TreatWarningsAsErrors.
# ──────────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8618.severity = error

# ──────────────────────────────────────────────────────────────────────────────
# Meziantou.Analyzer rules
# ──────────────────────────────────────────────────────────────────────────────
# MA0004: Use Task.ConfigureAwait(false) (library code must not capture the caller's context)
dotnet_diagnostic.MA0004.severity = error
# MA0029: Combine LINQ methods (performance)
dotnet_diagnostic.MA0029.severity = warning
# MA0051: Method is too long (maintainability)
dotnet_diagnostic.MA0051.severity = warning

# ──────────────────────────────────────────────────────────────────────────────
# Roslynator rules
# ──────────────────────────────────────────────────────────────────────────────
# RCS1242: Do not pass a non-read-only struct by read-only reference (avoids defensive copies)
dotnet_diagnostic.RCS1242.severity = warning
# RCS1194: Implement exception constructors
dotnet_diagnostic.RCS1194.severity = warning
