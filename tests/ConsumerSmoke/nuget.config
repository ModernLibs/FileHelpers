<?xml version="1.0" encoding="utf-8"?>
<!-- Default sources for editing the smoke projects by hand. run.sh restores with its own generated config
     (the package folder plus nuget.org), so this file never carries a local path. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
