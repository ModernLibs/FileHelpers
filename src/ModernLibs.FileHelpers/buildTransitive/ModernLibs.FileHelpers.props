<Project>
  <!--
    Makes the FileHelpersMaxFieldWidth MSBuild property visible to the ModernLibs.FileHelpers source
    generator (diagnostic MLFH007, default 1000 characters). Usage in a consuming project:
      <PropertyGroup><FileHelpersMaxFieldWidth>2000</FileHelpersMaxFieldWidth></PropertyGroup>
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="FileHelpersMaxFieldWidth" />
  </ItemGroup>
</Project>
