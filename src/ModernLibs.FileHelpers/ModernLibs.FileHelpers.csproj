<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>4.0.0</Version>
    <PackageId>ModernLibs.FileHelpers</PackageId>
    <Authors>ModernLibs Contributors</Authors>
    <Copyright>Copyright © ModernLibs Contributors 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>FileHelpers;CSV;FixedLength;Delimited;AOT;Source Generator;net10;Performance;SIMD;ZeroAllocation;Span;Pipelines;Parallel</PackageTags>
    <RepositoryUrl>https://github.com/ModernLibs/FileHelpers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ModernLibs/FileHelpers</PackageProjectUrl>
    <PackageDescription>Modern, AOT-ready rewrite of FileHelpers for .NET 10. High-performance delimited and fixed-width parsing with SIMD acceleration, parallel reading, zero per-record allocations, and source-generated descriptors. API compatible with FileHelpers 3.x — migration is a single using change.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>ModernLibs.FileHelpers 4.0.0 — AOT-compatible delimited and fixed-width parsing. Features: Source-generated record descriptors (zero reflection), SIMD-accelerated delimiter detection (AVX2/NEON/Vector&lt;T&gt;), Parallel batch reading engine, Async streaming with IAsyncEnumerable&lt;T&gt; and System.IO.Pipelines, Zero per-record allocations for record struct types, SpanRecord ref struct support for callback-based parsing, RecordPool&lt;T&gt; for class-type object pooling, Multi-record and master-detail engines with CommonSelector presets, Culture-aware parsing with per-field CultureInfo, Engine interfaces (IFileHelperEngine&lt;T&gt;) for DI/testing, Enhanced diagnostics (MLFH001-MLFH009) with actionable guidance, Full FileHelpers 3.x migration compatibility for supported surface. Migration: Change 'using FileHelpers' to 'using ModernLibs.FileHelpers'</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../ModernLibs.FileHelpers.Generator/ModernLibs.FileHelpers.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <!-- Embed the source generator as an analyzer in the package -->
    <None Include="..\ModernLibs.FileHelpers.Generator\bin\$(Configuration)\netstandard2.0\ModernLibs.FileHelpers.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>
</Project>
