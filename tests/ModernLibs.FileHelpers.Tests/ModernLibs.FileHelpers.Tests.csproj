<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);NU1900;CS0219</NoWarn>
    <NuGetAudit>false</NuGetAudit>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <!-- Generator output and caching tests.
         Using Microsoft.CodeAnalysis.CSharp directly (via generator ProjectReference) rather than
         SourceGenerators.Testing — that package pulls in Roslyn 3.8.0 which conflicts with 4.14.0
         and loses AsSourceGenerator/TrackedOutputSteps/IncrementalStepRunReason resolution. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../../src/ModernLibs.FileHelpers/ModernLibs.FileHelpers.csproj" />
    <!-- Direct reference so tests can instantiate FileHelpersGenerator in Roslyn in-process tests -->
    <ProjectReference Include="../../src/ModernLibs.FileHelpers.Generator/ModernLibs.FileHelpers.Generator.csproj" />
    <!-- Analyzer reference so the generator actually runs on this test project at build time,
         emitting [ModuleInitializer] descriptors for types like SimpleDelimitedRecord.
         ReferenceOutputAssembly=false avoids double-loading the generator DLL. -->
    <ProjectReference Include="../../src/ModernLibs.FileHelpers.Generator/ModernLibs.FileHelpers.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Golden canonical texts of the 4.9.1 descriptors, read by Compat49Tests (see Compat/Generated49/README.md). -->
    <EmbeddedResource Include="Compat/Golden49/*.txt" LogicalName="Golden49/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The exit code mapping of the fuzz runner (FuzzExitTests); it lives in the Fuzz project, an executable. -->
    <Compile Include="../ModernLibs.FileHelpers.Fuzz.Tests/FuzzExit.cs" Link="Fuzz/FuzzExit.cs" />
  </ItemGroup>

</Project>
