<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>4.0.0</Version>
    <PackageId>ModernLibs.FileHelpers</PackageId>
    <Authors>ModernLibs Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>FileHelpers;CSV;FixedLength;Delimited;AOT;Source Generator;net10</PackageTags>
    <RepositoryUrl>https://github.com/ModernLibs/FileHelpers</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../ModernLibs.FileHelpers.Generator/ModernLibs.FileHelpers.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
