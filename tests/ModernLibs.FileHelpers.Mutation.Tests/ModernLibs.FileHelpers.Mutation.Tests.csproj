<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!--
      Phase 28 closure (SPEC-02 scoped exception): the xUnit.v3 in-process
      runner returns exit code 0 for an empty discovery, so the previous
      ignore-exit-code 8 workaround is no longer required. When
      dotnet test is used (Microsoft.Testing.Platform path), exit 8
      surfaces "zero tests ran"; reintroduce the argument here only if a
      future runner change starts treating empty discovery as failure.
      See tests/ModernLibs.FileHelpers.Mutation.Tests/README.md.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/ModernLibs.FileHelpers/ModernLibs.FileHelpers.csproj" />
  </ItemGroup>
</Project>
