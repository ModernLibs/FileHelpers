{
  "stryker-config": {
    "project": "src/ModernLibs.FileHelpers/ModernLibs.FileHelpers.csproj",
    "test-projects": [
      "tests/ModernLibs.FileHelpers.Mutation.Tests/ModernLibs.FileHelpers.Mutation.Tests.csproj"
    ],
    "mutate": [
      "**/*Engine*.cs",
      "**/*Enumerator*.cs",
      "**/*Slicer*.cs",
      "**/*LineReader*.cs"
    ],
    "reporters": [
      "progress",
      "dots",
      "html"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "baseline": {
      "enabled": true,
      "fallback-version": "main"
    },
    "language-version": "latest"
  }
}
