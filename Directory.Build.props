<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      TreatWarningsAsErrors is conditioned to exclude generator projects (D-09).
      The generator targets netstandard2.0 and sets IsRoslynComponent=true.
      Roslyn/Meziantou rules fire on netstandard2.0 patterns that are valid there —
      letting them become errors would block the generator build.
    -->
    <TreatWarningsAsErrors Condition="'$(IsRoslynComponent)' != 'true'">true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      latest-recommended (not latest-all) per design spec §12.
      latest-all enables experimental rules with high false-positive rate.
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Three-layer analyzer stack (D-07).
      PrivateAssets="all" prevents analyzers from leaking into consumers.
      Versions declared in Directory.Packages.props (CPM, D-06).
    -->
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
