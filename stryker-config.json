{
  "stryker-config": {
    "project": "src/ModernLibs.FileHelpers/ModernLibs.FileHelpers.csproj",
    "test-projects": [
      "tests/ModernLibs.FileHelpers.Mutation.Tests/ModernLibs.FileHelpers.Mutation.Tests.csproj"
    ],
    "mutate": [
      "**/Engines/RecordReadCore.cs",
      "**/Engines/RecordReadSession.cs",
      "**/Engines/LogicalLineAssembler.cs",
      "**/Parsing/*LineReader.cs",
      "**/Parsing/TextReaderLineSource.cs",
      "**/Parsing/LineSplitter.cs",
      "**/Parsing/QuoteBalanceScanner.cs",
      "**/Parsing/FixedLengthSlicer.cs",
      "**/Converters/NumberConversion.cs",
      "**/MultiRecord/*Engine*.cs",
      "**/MasterDetail/*Engine*.cs"
    ],
    "reporters": [
      "progress",
      "dots",
      "html"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "language-version": "latest"
  }
}
