<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source generator host.
         Version pinned to 4.14.0: SDK ships Roslyn 5.0.0.0; analyzers targeting 5.3.0 are rejected
         with CS9057 ("references newer compiler version"). Roslyn 4.x analyzers load in any 4.x or 5.x
         compiler (backward-compatible). 4.14.0 includes ForAttributeWithMetadataName and all required APIs. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

    <!-- Static analysis: Roslynator, Meziantou.Analyzer, .NET SDK analyzers -->
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.46" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.201" />

    <!-- Public API baseline (library only): PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt.
         4.14.0 for the same reason as Microsoft.CodeAnalysis.CSharp above (SDK compiler is Roslyn 5.0). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />

    <!-- Generator testing -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.3" />

    <!-- Test framework — TUnit (primary) + xUnit v3 (Stryker target) -->
    <PackageVersion Include="TUnit" Version="1.30.8" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Fuzzing (tests/ModernLibs.FileHelpers.Fuzz.Tests) -->
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Sylvan.Data.Csv" Version="1.4.0" />
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="FileHelpers" Version="3.5.2" />
    <PackageVersion Include="Sep" Version="0.14.1" />

    <!-- Packaging -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>
</Project>
