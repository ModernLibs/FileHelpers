<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      TreatWarningsAsErrors is conditioned to exclude the source generator project.
      The generator targets netstandard2.0 and sets IsRoslynComponent=true.
      Roslyn/Meziantou rules fire on netstandard2.0 patterns that are valid there —
      letting them become errors would block the generator build.
    -->
    <TreatWarningsAsErrors Condition="'$(IsRoslynComponent)' != 'true'">true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      latest-recommended (not latest-all): the rules Microsoft recommends. latest-all also turns on
      every rule that is off by default, many of which are noisy for this code base.
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Analyzer stack: Roslynator, Meziantou.Analyzer and the .NET SDK analyzers.
      PrivateAssets="all" keeps the analyzers out of the package dependencies of consumers.
      Versions are declared in Directory.Packages.props (central package management).
    -->
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
