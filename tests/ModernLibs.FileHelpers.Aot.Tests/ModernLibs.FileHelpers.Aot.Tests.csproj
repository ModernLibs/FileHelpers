<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Smoke checks compare against literals; culture-neutral by InvariantGlobalization, no sync context in a console app; fixtures share Records.cs. -->
    <NoWarn>$(NoWarn);MA0004;MA0006;MA0011;MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ModernLibs.FileHelpers/ModernLibs.FileHelpers.csproj" />
    <!-- The generator attaches as an analyzer (as in the NuGet package); AOT needs the generated descriptors. -->
    <ProjectReference Include="../../src/ModernLibs.FileHelpers.Generator/ModernLibs.FileHelpers.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- CI aot-smoke legacy leg (T18, design 4.7): the 4.9 read path and the legacy write path (DisableRecordWriter) must stay in a trimmed
       application. The switches go into the runtime configuration that Native AOT compiles in; the program prints
       legacy-switch=on|off and legacy-write-switch=on|off. -->
  <ItemGroup Condition="'$(FhAotLegacy)' == 'true'">
    <RuntimeHostConfigurationOption Include="ModernLibs.FileHelpers.DisableTokenizedParse" Value="true" />
    <RuntimeHostConfigurationOption Include="ModernLibs.FileHelpers.DisableRecordWriter" Value="true" />
  </ItemGroup>

</Project>
