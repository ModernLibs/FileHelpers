<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Emitted into [GeneratedCode]. Keep equal to <Version> in ModernLibs.FileHelpers.csproj; GeneratedCodeAttributeTests checks. -->
    <Version>4.10.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TreatWarningsAsErrors is conditioned in Directory.Build.props to skip when IsRoslynComponent=true -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Diagnostics/AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="Diagnostics/AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>
