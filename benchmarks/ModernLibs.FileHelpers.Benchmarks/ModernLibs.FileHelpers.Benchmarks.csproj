<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Benchmarks intentionally excluded from TreatWarningsAsErrors (open question from research) -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Sylvan.Data.Csv" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="FileHelpers" />
    <PackageReference Include="Sep" />
    <ProjectReference Include="../../src/ModernLibs.FileHelpers/ModernLibs.FileHelpers.csproj" />
    <!-- Generator reference so [DelimitedRecord]/[FixedLengthRecord] types in benchmarks get descriptors -->
    <ProjectReference Include="../../src/ModernLibs.FileHelpers.Generator/ModernLibs.FileHelpers.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
